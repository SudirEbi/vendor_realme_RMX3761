# Essential partitions
/boot            emmc  /dev/block/by-name/boot           flags=backup=1;flashing=1;slotselect;display="Boot"
/dtbo            emmc  /dev/block/by-name/dtbo           flags=backup=1;slotselect;display="DTBO"
/vbmeta          emmc  /dev/block/by-name/vbmeta         flags=backup=1;slotselect;display="VBMeta"
/vbmeta_system   emmc  /dev/block/by-name/vbmeta_system  flags=backup=1;slotselect;display="VBMeta System"
/vbmeta_vendor   emmc  /dev/block/by-name/vbmeta_vendor  flags=backup=1;slotselect;display="VBMeta Vendor"
/misc            emmc  /dev/block/by-name/misc           flags=backup=1;display="Misc"

# Dynamic partitions
/system          erofs /dev/block/by-name/system         flags=backup=1;logical;slotselect;display="System";avb=vbmeta_system
/system_ext      erofs /dev/block/by-name/system_ext     flags=backup=1;logical;slotselect;display="System Ext";avb=vbmeta_system
/vendor          erofs /dev/block/by-name/vendor         flags=backup=1;logical;slotselect;display="Vendor";avb=vbmeta_vendor
/product         erofs /dev/block/by-name/product        flags=backup=1;logical;slotselect;display="Product";avb=vbmeta_product

# Data, metadata, and cache
/data            f2fs  /dev/block/by-name/userdata       flags=backup=1;display="Data";fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized;keydirectory=/metadata/vold/metadata_encryption;formattable;checkpoint=fs
/cache           f2fs  /dev/block/by-name/cache          flags=backup=1;display="Cache";formattable;check
/metadata        f2fs  /dev/block/by-name/metadata       flags=backup=1;display="Metadata";formattable;check

# Optional but useful partitions
/persist         emmc  /dev/block/by-name/persist        flags=backup=1;display="Persist"
/logo            emmc  /dev/block/by-name/logo           flags=backup=1;display="Logo"
/fbootlogo       emmc  /dev/block/by-name/fbootlogo      flags=backup=1;display="Fastboot Logo"
/uboot           emmc  /dev/block/by-name/uboot          flags=backup=1;slotselect;display="U-Boot"
/trustos         emmc  /dev/block/by-name/trustos        flags=backup=1;slotselect;display="TrustOS"
/teecfg          emmc  /dev/block/by-name/teecfg         flags=backup=1;slotselect;display="TEE Config"

# USB OTG support
/usb-otg         auto  /dev/block/sda1 /dev/block/sda    flags=removable;storage;display="USB OTG"

# External SD Card support
/external_sd     auto  /dev/block/mmcblk1p1 /dev/block/mmcblk1 flags=removable;storage;display="SD Card"
